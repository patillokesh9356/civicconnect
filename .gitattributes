# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text eol=lf

# JS/JSX/CSS
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.ico  binary
