# ============================================================
# CivicConnect — .gitignore
# ============================================================

# --- SECRETS (never commit these) ---
.env
.env.local
.env.production
.env*.local
*.key
*.pem

# --- Python / Backend ---
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
